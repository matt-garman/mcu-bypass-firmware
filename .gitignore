# vim backup files
*~

# compilation artifacts
*.hex
*.elf
build_avr_classic/
build_pic10f322/
# Retired spelling (pre-v0.9.8). A worktree that predates the rename still has
# build_pic/, and its .p1/.d/.sdb/.sym/.cmf artifacts match none of the global
# patterns above -- so without this line `git add -A` commits XC8 intermediates.
build_pic/
build_avr_xt/
# PIC10F320 build + coverage artifacts (coverage lives UNDER the build dir, so
# this one entry covers both, and no PIC10F320 recipe can reach the shared
# top-level coverage/)
build_pic10f320/
build_pic12f675/

# vendored ATtiny_DFP device files for the ATtiny202 (AVR-XT) build -- fetched
# on demand by scripts/fetch_attiny_dfp.sh (pinned version + SHA), NOT committed,
# mirroring the external/uncommitted PIC_DFP. Override the location with XT_DFP.
# NOTE: ignore the CONTENTS (third_party/*), not the directory itself
# (third_party/), so the negations below can re-include specific files -- git
# will not descend into a directory excluded with a trailing slash.
third_party/*

# ...EXCEPT the yasimavr upstream-bug patches, which ARE tracked: they are the
# source of truth for scripts/fetch_yasimavr.sh (which builds the patched
# yasimavr venv used by the attiny202-{sim,soak,fault} harness). The venv it
# produces IS a generated artifact and stays ignored. Same escape as release/**.
!third_party/yasimavr/
third_party/yasimavr/venv/
# A verified replacement keeps the prior stamped venv as a randomized sibling
# rollback point rather than recursively deleting a caller-derived path.
third_party/yasimavr/.venv.old.*/

# ...EXCEPT the prebuilt release images, which ARE tracked: committing them is
# the whole point of release/ (scripts/make-release.sh stages them there). The
# global *.hex ignore above would otherwise silently drop them from `git add`.
!release/**/*.hex

# cppcheck addon artifacts (e.g. "make analyze-misra"); normally auto-cleaned,
# but a cancelled run can leave them behind
*.dump
*.ctu-info
cppcheck-addon-ctu-file-list*

# gpsim drops this log (often 0-byte) in the cwd on every `make pic10f322-test-soak`
gpsim.log

# Persistent inode used to serialize complete Make and release invocations.
/.make.lock

# coverage artifacts (generated by "make coverage")
coverage/
# Stray gcov artifacts. Every gate runs gcov in a private temporary directory
# and cleans up after itself, so these should never appear -- but an interrupted
# run leaves them at the repo root, where `git add -A` would happily commit them.
*.gcda
*.gcno
*.gcov

# The commit message the release script and the development workflow generate
# for the human to use with `git commit -F`. A working note, never an artifact.
# Anchored to the root so this rule affects only the development-time copy;
# release/.gitignore deliberately ignores the per-release copies too.
/commit_msg.txt

# clade code
.claude/

# python byte-compiled files
__pycache__/
