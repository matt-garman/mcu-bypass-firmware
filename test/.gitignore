# Compiled test binaries live next to their sources in per-substrate subdirs.
host/test_logic_host
formal/test_model_check
formal/test_symbolic
formal/test_symbolic.bc
formal/bypass_pure_klee.bc
formal/test_symbolic_klee.bc
avr/test_fuses
avr/test_soak_*5
pic/test_config_pic
pic/test_config_pic12f675
pic/test_soak_pic
pic/test_fault_pic
pic/test_io_pic
pic/test_io_pic12f675
pic/test_lockstep_pic
pic/test_lockstep_pic12f675
# per-variant simavr harnesses: test_sim_<variant>[_t85], test_trace_<variant>
avr/test_sim
avr/test_sim_*
avr/test_trace_*
# ...but the yasimavr harness DRIVERS are Python source, not compiled binaries:
# keep every avr/*.py tracked even though names like test_sim_attiny202.py would
# otherwise match the compiled-binary globs above. Only the bytecode cache is
# ignored.
!avr/*.py
avr/__pycache__/

# python byte-compiled files
__pycache__/

# KLEE output. The Makefile pins it to test/formal/klee-out; the unsuffixed
# klee-last / klee-out-*/ entries stay because KLEE's own default naming lands
# there when the solver is driven by hand, and because existing worktrees may
# still carry the pre-`src/`-reorganization copies at the test root. These are
# pathless patterns, so they match at any depth under test/. `make clean`
# removes all three forms. Keep the retired toolchain stamp ignored too.
klee-out/
klee-last
klee-out-*/
.toolchain.sig
